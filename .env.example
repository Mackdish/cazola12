# Supabase configuration (public / client-safe)
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# R2 / media
R2_PUBLIC_URL=

# Email (Resend). Server-side only. Never expose to client/Vite code.
RESEND_API_KEY=

# Server-side pepper for API key hashing. Never expose to client/Vite code.
API_KEY_PEPPER=

# Gemini AI (server-side only; never expose via VITE_*)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# Multi-provider AI gateway (server-side only)
# Providers are attempted in this order. Remove/unset providers you do not use.
AI_PROVIDER_ORDER=gemini,grok,openai,claude,mistral,deepseek,ollama

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

XAI_API_KEY=
XAI_MODEL=grok-4-1-fast-reasoning

# Ollama can run locally or on your own server/VPS. Example: http://127.0.0.1:11434
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.2:3b
