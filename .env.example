# Supabase configuration (public / client-safe)
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# R2 / media
R2_PUBLIC_URL=

# Email (Resend). Server-side only. Never expose to client/Vite code.
RESEND_API_KEY=

# Server-side pepper for API key hashing. Never expose to client/Vite code.
API_KEY_PEPPER=

# Gemini is no longer used by the TradeMall text AI gateway.
# It is kept here only for the separate optional Gemini image fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# AI image provider. Cloudflare is the default and uses the Workers AI binding.
# Set AI_IMAGE_FALLBACK_PROVIDER=gemini only if you explicitly want Gemini as a paid fallback.
AI_IMAGE_PROVIDER=cloudflare
AI_IMAGE_FALLBACK_PROVIDER=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# TradeMall text AI: Cloudflare Workers AI ONLY. No external text provider is used.
# The Worker must have an AI binding named AI in wrangler.jsonc.
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.1-8b-instruct-fast
CLOUDFLARE_AI_VISION_MODEL=@cf/meta/llama-3.2-11b-vision-instruct

# Ad serving. 350ms gives the database/Redis serving path more headroom than the
# previous 200ms cutoff while still failing fast to the house-ad fallback.
# Keep this between 200ms and 1000ms; omit it to use the 350ms default.
AD_SERVE_TIMEOUT_MS=350

# Legacy provider keys are intentionally ignored by the text gateway.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
XAI_API_KEY=
XAI_MODEL=grok-4-1-fast-reasoning
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.2:3b
