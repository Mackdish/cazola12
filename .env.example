# Supabase configuration (public / client-safe)
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# R2 / media
R2_PUBLIC_URL=

# Server-side OpenAI API key. Never expose to client/Vite code.
OPENAI_API_KEY=

# Optional: override default AI model
OPENAI_MODEL=gpt-4o-mini

# Optional: override the Cloudflare Workers AI model (requires the AI binding).
WORKERS_AI_MODEL=@cf/meta/llama-3.1-8b-instruct

# Server-side Gemini API key. Never expose to client/Vite code.
GEMINI_API_KEY=

# Optional: override default Gemini model
GEMINI_MODEL=gemini-2.0-flash

# AI provider selection: "workers-ai" (default) or "openai"
AI_PROVIDER=workers-ai

# Email (Resend). Server-side only. Never expose to client/Vite code.
RESEND_API_KEY=

# Server-side pepper for API key hashing. Never expose to client/Vite code.
API_KEY_PEPPER=
