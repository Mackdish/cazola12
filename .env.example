# Supabase configuration (public / client-safe)
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# R2 / media
R2_PUBLIC_URL=

# Email (Resend). Server-side only. Never expose to client/Vite code.
RESEND_API_KEY=

# Server-side pepper for API key hashing. Never expose to client/Vite code.
API_KEY_PEPPER=

# Gemini AI (server-side only; never expose via VITE_*)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# AI image provider. Cloudflare is the default and uses the Workers AI binding.
# Set AI_IMAGE_FALLBACK_PROVIDER=gemini only if you want Gemini as a paid fallback.
AI_IMAGE_PROVIDER=cloudflare
AI_IMAGE_FALLBACK_PROVIDER=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# Multi-provider AI gateway (server-side only)
# Cloudflare Workers AI uses the existing AI binding and needs no API key.
# Cloudflare is automatically retained as a fallback even if this list omits it.
AI_PROVIDER_ORDER=cloudflare,gemini,grok,openai,claude,mistral,deepseek,ollama
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.2-3b-instruct

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

XAI_API_KEY=
XAI_MODEL=grok-4-1-fast-reasoning

# Ollama can run locally or on your own server/VPS. Example: http://127.0.0.1:11434
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.2:3b
