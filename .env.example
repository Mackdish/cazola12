# Supabase configuration (public / client-safe)
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# R2 / media
R2_PUBLIC_URL=

# Optional: override the Cloudflare Workers AI model (requires the AI binding).
WORKERS_AI_MODEL=@cf/meta/llama-3.1-8b-instruct

# Email (Resend). Server-side only. Never expose to client/Vite code.
RESEND_API_KEY=

# Server-side pepper for API key hashing. Never expose to client/Vite code.
API_KEY_PEPPER=
